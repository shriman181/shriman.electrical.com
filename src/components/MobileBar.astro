---
import company from '../data/company.json';
const wa = 'https://wa.me/' + company.primaryWhatsapp + '?text=' + encodeURIComponent('Hi, I would like to enquire about your products. (via shrimanelectrical.com)');
---
<div class="mbar">
  <a class="mb mb-call" href={'tel:' + company.primaryPhoneHref}>Call us</a>
  <a class="mb mb-wa" href={wa} rel="noopener">WhatsApp</a>
</div>

<style>
.mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 45; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
@media (min-width: 768px) { .mbar { display: none; } }
.mb { display: flex; align-items: center; justify-content: center; min-height: 60px; font-size: 16px; font-weight: 500; }
.mb:hover { text-decoration: none; }
.mb-call { background: var(--navy); color: #fff; }
.mb-wa { background: var(--whatsapp); color: #06331A; }
</style>
