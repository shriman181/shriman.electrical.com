---
import Base from '../layouts/Base.astro';
import Enquire from '../components/Enquire.astro';
import company from '../data/company.json';
import catalogue from '../data/catalogue.json';
const n = [...new Set(catalogue.flatMap(c => c.brands.map(b => b.brand)))].length;
const md = company.md;
const a = company.address;
const title = 'About | Shriman Electrical Associates Pvt. Ltd., Navi Mumbai';
const description = 'Shriman Electrical Associates has distributed industrial electrical products in Navi Mumbai since 2008, supplying panel builders, OEMs, contractors and plants. Led by Dinesh Maheshwari.';
---
<Base title={title} description={description}>

<section class="band band-dark">
  <div class="wrap">
    <p class="crumbs light"><a href="/">Home</a> / About</p>
    <p class="eyebrow">About us</p>
    <h1>Stocking industrial electrical since 2008.</h1>
    <p class="lead">We are a distributor, not a trader of whatever is going. We hold stock in Navi Mumbai, we carry the brands that panel drawings actually call for, and we answer the phone.</p>
  </div>
</section>

<section class="band band-white">
  <div class="wrap md">
    <figure class="md-fig">
      <img src={md.photo} alt={md.name + ', ' + md.role + ' of ' + company.name} width="900" height="1200" loading="lazy" />
    </figure>
    <div class="md-body">
      <p class="eyebrow">Leadership</p>
      <h2>{md.name}</h2>
      <p class="md-role">{md.role}</p>
      <p>{md.name} has led Shriman Electrical Associates since its founding in {company.founded}, building the business from a single counter into a multi-brand distribution operation serving Navi Mumbai, Thane and Mumbai.</p>
      <p>The approach has not changed much in that time: keep the right stock, know the products properly, and give customers a person they can call rather than a queue they have to join.</p>
      <a class="li" href={md.linkedin} rel="noopener" aria-label={'View ' + md.name + ' on LinkedIn'}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        <span>Connect on LinkedIn</span>
      </a>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap two">
    <div class="prose">
      <h2>How we work</h2>
      <p>Most of what we supply goes into LT panels, machines and plant upgrades around Navi Mumbai. That means the questions we get are specific: a rating, a make, a delivery date. Our job is to answer those quickly and correctly.</p>
      <p>We keep {n} principals in the basket rather than chasing every brand, so that when a drawing specifies a make, we can supply it as specified instead of pushing an alternative.</p>
      <h2>What we stand on</h2>
      <p>Genuine product with documentation. Stock held locally so a routine item does not become a three-week wait. Named people you can reach directly rather than a call centre. And enough product knowledge on the counter to catch a mis-specified item before it ships.</p>
    </div>
    <aside class="facts">
      <p class="eyebrow">At a glance</p>
      <dl class="fl">
        <div><dt>Established</dt><dd>{company.founded}</dd></div>
        <div><dt>Principal brands</dt><dd>{n}</dd></div>
        <div><dt>Product categories</dt><dd>{catalogue.length}</dd></div>
        <div><dt>Location</dt><dd>{a.locality}, {a.city}</dd></div>
        <div><dt>Serving</dt><dd>Navi Mumbai, Thane, Mumbai</dd></div>
        <div><dt>Hours</dt><dd>{company.hours}</dd></div>
      </dl>
    </aside>
  </div>
</section>

<section class="band band-white">
  <div class="wrap"><Enquire /></div>
</section>

</Base>

<style>
.crumbs.light, .crumbs.light a { color: #93A3BD; }

.md { display: grid; gap: var(--s6); align-items: start; }
@media (min-width: 900px) { .md { grid-template-columns: minmax(0, 380px) minmax(0, 1fr); gap: var(--s9); } }
.md-fig { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--canvas); }
.md-fig img { width: 100%; height: auto; }
.md-body h2 { margin-bottom: var(--s1); }
.md-role { color: var(--copper); font-size: 15px; font-weight: 500; margin: 0 0 var(--s5); }
.md-body p { max-width: 62ch; }

.li { display: inline-flex; align-items: center; gap: var(--s2); min-height: 44px; padding: 0 var(--s4); margin-top: var(--s3); border: 1px solid var(--line); border-radius: var(--radius); color: var(--navy); font-size: 15px; font-weight: 500; }
.li:hover { border-color: var(--blue); color: var(--blue); text-decoration: none; }
.li svg { flex: 0 0 auto; }

.two { display: grid; gap: var(--s7); }
@media (min-width: 900px) { .two { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--s9); } }
.facts { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--s5); align-self: start; }
.fl { margin: 0; display: grid; gap: var(--s4); }
.fl dt { font-size: 13px; color: var(--slate); }
.fl dd { margin: 2px 0 0; font-size: 17px; font-weight: 500; color: var(--navy); font-variant-numeric: tabular-nums; }
</style>
